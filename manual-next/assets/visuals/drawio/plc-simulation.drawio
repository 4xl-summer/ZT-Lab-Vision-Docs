<mxfile host="app.diagrams.net" type="device"><diagram name="모의 PLC 요청과 결과 확인" id="plc-simulation"><mxGraphModel dx="1500" dy="1345" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1500" pageHeight="1345" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="모의 PLC 요청과 결과 확인" style="text;html=1;whiteSpace=wrap;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="25" width="1360" height="55" as="geometry" /></mxCell><mxCell id="box0" value="Idle&#10;요청 대기" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf5ff;strokeColor=#3572a5;fontColor=#17324d;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="125" width="320" height="105" as="geometry" /></mxCell><mxCell id="box1" value="Request&#10;증가한 양의 요청 ID" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf5ff;strokeColor=#3572a5;fontColor=#17324d;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="330" width="320" height="105" as="geometry" /></mxCell><mxCell id="box2" value="Waiting&#10;현재 요청의 결과 대기" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf5ff;strokeColor=#3572a5;fontColor=#17324d;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="535" width="320" height="105" as="geometry" /></mxCell><mxCell id="box3" value="Publish&#10;같은 ID와 결과 코드" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf5ff;strokeColor=#3572a5;fontColor=#17324d;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="385" y="740" width="320" height="105" as="geometry" /></mxCell><mxCell id="box4" value="ResultReady&#10;Ack 후 Idle로 복귀" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf5ff;strokeColor=#3572a5;fontColor=#17324d;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="945" widt