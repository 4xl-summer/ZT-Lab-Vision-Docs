<mxfile host="app.diagrams.net" type="device"><diagram name="지연 쿼리의 구성과 실행" id="query-execution"><mxGraphModel dx="1500" dy="1550" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1500" pageHeight="1550" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="지연 쿼리의 구성과 실행" style="text;html=1;whiteSpace=wrap;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="25" width="1360" height="55" as="geometry" /></mxCell><mxCell id="box0" value="입력 이미지&#10;형식과 크기를 확인" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf5ff;strokeColor=#3572a5;fontColor=#17324d;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="125" width="320" height="105" as="geometry" /></mxCell><mxCell id="box1" value="쿼리 구성&#10;원하는 연산 단계를 연결" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf5ff;strokeColor=#3572a5;fontColor=#17324d;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="330" width="320" height="105" as="geometry" /></mxCell><mxCell id="box2" value="실행 전&#10;단계 정의; 픽셀 연산은 아직 수행하지 않음" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf5ff;strokeColor=#3572a5;fontColor=#17324d;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="535" width="320" height="105" as="geometry" /></mxCell><mxCell id="box3" value="명시적 실행&#10;선택한 terminal 실행" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf5ff;strokeColor=#3572a5;fontColor=#17324d;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="740" width="320" height="105" as="geometry" /></mxCell><mxCell id="box4" value="결과 확인&#10;결과형과 진단을 확인" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf5ff;strokeColor=#3572a5;fontColor=#17324d;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="945" w