x="750" y="895" /><mxPoint x="750" y="895" /></Array></mxGeometry></mxCell><mxCell id="edge4" value="종료" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#526779;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitPerimeter=1;entryX=0.500;entryY=0.000;entryPerimeter=1;" edge="1" parent="1" source="box4" target="box5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="750" y="1100" /><mxPoint x="750" y="1100" /></Array></mxGeometry></mxCell><mxCell id="notes" value="• 정확한 실행 메서드와 반환형은 언어별 API에서 확인합니다.&#10;• 구성 성공만으로 실행 성공이나 특정 입력 형식의 지원이 보장되지는 않습니다." style="text;html=0;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="70" y="1390" width="1360" height="120" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>