<mxfile host="app.diagrams.net" type="device"><diagram name="프레임 큐의 소유권과 대기" id="frame-queue"><mxGraphModel dx="1500" dy="1345" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1500" pageHeight="1345" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="프레임 큐의 소유권과 대기" style="text;html=1;whiteSpace=wrap;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="25" width="1360" height="55" as="geometry" /></mxCell><mxCell id="box0" value="생산자 이미지&#10;호출자가 소유하는 이미지" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf5ff;strokeColor=#3572a5;fontColor=#17324d;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="125" width="320" height="105" as="geometry" /></mxCell><mxCell id="box1" value="offer&#10;용량과 가득 찼을 때 정책 적용" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf5ff;strokeColor=#3572a5;fontColor=#17324d;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="330" width="320" height="105" as="geometry" /></mxCell><mxCell id="box2" value="유한 FIFO 큐&#10;저장된 영상은 소유 share" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf5ff;strokeColor=#3572a5;fontColor=#17324d;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="535" width="320" height="105" as="geometry" /></mxCell><mxCell id="box3" value="take&#10;항목·시간 초과·닫힘 확인" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf5ff;strokeColor=#3572a5;fontColor=#17324d;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="385" y="740" width="320" height="105" as="geometry" /></mxCell><mxCell id="box4" value="꺼낸 이미지&#10;독립 핸들로 사용 후 해제" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf5ff;strokeColor=#3572a5;fontColor=#17324d;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="94