<mxfile host="app.diagrams.net" type="device"><diagram name="이미지 공유와 ROI의 수명" id="image-ownership"><mxGraphModel dx="1500" dy="1140" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1500" pageHeight="1140" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="이미지 공유와 ROI의 수명" style="text;html=1;whiteSpace=wrap;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="25" width="1360" height="55" as="geometry" /></mxCell><mxCell id="box0" value="원본 ZImage&#10;소유 이미지와 원점" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf5ff;strokeColor=#3572a5;fontColor=#17324d;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="125" width="320" height="105" as="geometry" /></mxCell><mxCell id="box1" value="share() / Share()&#10;픽셀 복사 없이 새 소유 객체" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf5ff;strokeColor=#3572a5;fontColor=#17324d;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="180" y="330" width="320" height="105" as="geometry" /></mxCell><mxCell id="box2" value="roi(rect) / Roi(rect)&#10;보이는 영역과 원점이 달라짐" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf5ff;strokeColor=#3572a5;fontColor=#17324d;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="330" width="320" height="105" as="geometry" /></mxCell><mxCell id="box3" value="공유 픽셀 저장소&#10;별도 객체들이 같은 저장소 참조" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf5ff;strokeColor=#3572a5;fontColor=#17324d;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="535" width="320" height="105" as="geometry" /></mxCell><mxCell id="box4" value="clone_deep() / CloneDeep()&#10;보이는 영역을 독립 버퍼에 복사" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf5ff;strokeColor=#3572a5;fontColor=#17324d;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="330" width="320" height="105" as="geometry" /></mxCell><mxCell id="box5" value="사용 종료&#10;각 언어의 소유 객체를 각각 해제" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf5ff;strokeColor=#3572a5;fontColor=#17324d;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="740" width="320" height="105" as="geometry" /></mxCell><mxCell id="edge0" value="공유" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#526779;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.250;exitY=1.000;exitPerimeter=1;entryX=0.500;entryY=0.000;entryPerimeter=1;" edge="1" parent="1" source="box0" target="box1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="670" y="280" /><mxPoint x="340" y="280" /></Array></mxGeometry></mxCell><mxCell id="edge1" value="영역" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#526779;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitPerimeter=1;entryX=0.500;entryY=0.000;entryPerimeter=1;" edge="1" parent="1" source="box0" target="box2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="750" y="280" /><mxPoint x="750" y="280" /></Array></mxGeometry></mxCell><mxCell id="edge2" value="참조" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#526779;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitPerimeter=1;entryX=0.333;entryY=0.000;entryPerimeter=1;" edge="1" parent="1" source="box1" target="box3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="340" y="485" /><mxPoint x="697" y="485" /></Array></mxGeometry></mxCell><mxCell id="edge3" value="참조" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#526779;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitPerimeter=1;entryX=0.667;entryY=0.000;entryPerimeter=1;" edge="1" parent="1" source="box2" target="box3">